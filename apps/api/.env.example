NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Runtime role: never use the owner / provider administrator here.
DATABASE_URL=postgresql://catalog_app:CHANGE_ME@localhost:5432/catalog
# Maintenance only; never inject this variable into the deployed API.
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/catalog
# Online PostgreSQL requires TLS with a verified server certificate.
DATABASE_TLS=false
# Only for a PostgreSQL service on an explicitly isolated server-side network.
DATABASE_PRIVATE_NETWORK=false
# Optional provider CA, PEM file path (system certificate trust by default).
# DATABASE_CA_FILE=
SESSION_TTL_HOURS=8
